# ============================================
# FlyMine Properties
# Generated from template by entrypoint.sh
# ============================================

# ============================================
# Production Database (Main Data)
# ============================================
db.production.datasource.class=com.zaxxer.hikari.HikariDataSource
db.production.datasource.serverName=${RDS_HOST}
db.production.datasource.databaseName=${RDS_DB_NAME}
db.production.datasource.user=${RDS_USER}
db.production.datasource.password=${RDS_PASSWORD}
db.production.datasource.maximumPoolSize=10
db.production.datasource.minimumIdle=2
db.production.driver=org.postgresql.Driver
db.production.platform=PostgreSQL

# ============================================
# Common Target Items Database
# ============================================
db.common-tgt-items.datasource.class=com.zaxxer.hikari.HikariDataSource
db.common-tgt-items.datasource.serverName=${RDS_HOST}
db.common-tgt-items.datasource.databaseName=${RDS_ITEMS_DB_NAME}
db.common-tgt-items.datasource.user=${RDS_USER}
db.common-tgt-items.datasource.password=${RDS_PASSWORD}
db.common-tgt-items.datasource.maximumPoolSize=5
db.common-tgt-items.datasource.minimumIdle=1
db.common-tgt-items.driver=org.postgresql.Driver
db.common-tgt-items.platform=PostgreSQL

# ============================================
# User Profile Database
# ============================================
db.userprofile-production.datasource.class=com.zaxxer.hikari.HikariDataSource
db.userprofile-production.datasource.serverName=${RDS_HOST}
db.userprofile-production.datasource.databaseName=${RDS_PROFILE_DB_NAME}
db.userprofile-production.datasource.user=${RDS_USER}
db.userprofile-production.datasource.password=${RDS_PASSWORD}
db.userprofile-production.datasource.maximumPoolSize=3
db.userprofile-production.datasource.minimumIdle=1
db.userprofile-production.driver=org.postgresql.Driver
db.userprofile-production.platform=PostgreSQL

# ============================================
# FlyBase Chado Source DB (read-only)
#
# Consumed by chado-db-flybase-dmel source (project.xml). Hosts the FlyBase
# Chado dump (FB2026_01.sql.gz from s3ftp.flybase.org/releases/<rel>/psql/).
# Default points at the `chado-pg` Postgres service defined alongside the
# builder in docker-compose.yml so the chado data lives on AllianceMineDev,
# not on the shared intermine-postgres RDS.
#
# Override CHADO_PG_* in .env if pointing at a different chado host (e.g. a
# pre-existing Cambridge-style RDS).
# ============================================
db.flybase.datasource.class=org.postgresql.ds.PGPoolingDataSource
db.flybase.datasource.dataSourceName=db.flybase
db.flybase.datasource.serverName=${CHADO_PG_HOST}
db.flybase.datasource.databaseName=${CHADO_PG_DB}
db.flybase.datasource.user=${CHADO_PG_USER}
db.flybase.datasource.password=${CHADO_PG_PASSWORD}
db.flybase.datasource.maxConnections=10
db.flybase.datasource.portNumber=${CHADO_PG_PORT}
db.flybase.driver=org.postgresql.Driver
db.flybase.platform=PostgreSQL

# ============================================
# Project Configuration
# ============================================
project.title=FlyMine
project.subTitle=An integrated database for Drosophila genomics
project.releaseVersion=${FLYMINE_RELEASE}
project.sitePrefix=${WEBAPP_BASEURL}

# ============================================
# Web Application / Deployment
# ============================================
webapp.deploy.url=${DEPLOY_URL}
webapp.baseurl=${WEBAPP_BASEURL}
webapp.path=flymine
webapp.manager=${DEPLOY_MANAGER}
webapp.password=${DEPLOY_PASSWORD}
webapp.port=${DEPLOY_PORT}
webapp.hostname=${DEPLOY_HOST}

tomcat.user=${DEPLOY_MANAGER}
tomcat.pwd=${DEPLOY_PASSWORD}

# ============================================
# BlueGenes Tools
# Required by webapp/build.gradle :blueGenesStart task.
# Defaults to a path inside the container; mount/symlink elsewhere if needed.
# ============================================
bluegenes.toolLocation=${BLUEGENES_TOOL_LOCATION}

# ============================================
# SuperUser Account
# ============================================
superuser.account=${SUPERUSER_ACCOUNT}
superuser.initialPassword=${SUPERUSER_PASSWORD}

# ============================================
# Performance Tuning
# ============================================
batch.size=1000
webapp.os.alias=os.production
webapp.query.cache.size=10000
webapp.query.cache.timeout=300

# XML Factory
systemProp.javax.xml.stream.XMLOutputFactory=com.sun.xml.internal.stream.XMLOutputFactoryImpl

# ============================================
# Solr URLs (multitenant 172.31.59.87:8983)
# entrypoint.sh resolves these from SOLR_HOST/SOLR_PORT + the FlyMine release
# ============================================
index.solrurl=${SOLR_INDEX_URL}
autocomplete.solrurl=${SOLR_AUTOCOMPLETE_URL}

# FlyMine Build Configuration
# Copy to .env and fill in values

# RDS Connection (required)
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=

# FlyMine Release Version (required)
# Free-form string used to suffix the production DB name. There is no FMS-equivalent
# API for FlyMine, so set explicitly. Defaults to today's date if unset (YYYYMMDD).
# Convention: use the InterMine release this build aligns with, e.g. 52.2026.04
# FLYMINE_RELEASE=52.2026.04

# Build Type: test or production (default: test)
BUILD_TYPE=test

# RC Number (optional)
# If not set, auto-detected from RDS (finds highest existing RC and increments)
# RC_NUMBER=1

# Profile Database (optional)
# Test builds default to flymine_userprofile_test (safe, not production).
# Production builds always use flymine_userprofile.
# Set COPY_PROFILE_DB=true to create a fresh per-RC copy.
# COPY_PROFILE_DB=true

# Deployment Target (optional - EC2 Tomcat)
# DEPLOY_HOST=ec2-host.example.com
# DEPLOY_PORT=8080
# DEPLOY_MANAGER=manager
# DEPLOY_PASSWORD=manager
# WEBAPP_BASEURL=http://localhost:8080
# SUPERUSER_ACCOUNT=superuser@mail_account
# SUPERUSER_PASSWORD=

# BlueGenes tool location (referenced by webapp/build.gradle :blueGenesStart)
# BLUEGENES_TOOL_LOCATION=/root/bluegenes-tools/node_modules

# Docker Build (optional)
# Override the branches the image clones at build time. Pin a SHA for reproducibility
# once you've validated a particular upstream state.
# FLYMINE_BRANCH=master
# FLYMINE_BIO_SOURCES_BRANCH=master
# IMAGE_TAG=latest

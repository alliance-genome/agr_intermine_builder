# Staged source — populated by scripts/build_and_push.sh from the operator's
# local fork at new_flymine/. Lives in the docker build context but not in git.
source/

# Data + gradle caches — generated by the running container.
data/
.gradle-cache/
.m2-cache/

# Python bytecode left over by sanity-check py_compile runs.
__pycache__/
*.pyc

# AllianceMine Build Configuration
# Copy to .env and fill in values

# RDS Connection (required)
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=

# Alliance Release Version (optional)
# If not set, fetched automatically from FMS API (default: "next" release)
# Set FMS_RELEASE_TYPE=current to use the current release instead
# ALLIANCE_RELEASE=9.0.0
# FMS_RELEASE_TYPE=next

# Build Type: test or production (default: test)
# Production builds should only happen via the "promote" command
BUILD_TYPE=test

# RC Number (optional)
# If not set, auto-detected from RDS (finds highest existing RC and increments)
# RC_NUMBER=1

# Profile Database (optional)
# Test builds default to alliancemine_userprofile_test (safe, not production).
# Production builds always use alliancemine_userprofile.
# Set COPY_PROFILE_DB=true to create a fresh per-RC copy instead
# (e.g., alliancemine_userprofile_rc1) from the production profile.
# COPY_PROFILE_DB=true

# Deployment Target (optional - EC2 Tomcat)
# Test builds deploy to port 8090, production to port 8080
# DEPLOY_HOST=ec2-host.example.com
# DEPLOY_PORT=8090
# DEPLOY_MANAGER=manager
# DEPLOY_PASSWORD=manager

# Solr (external Solr on EC2)
# SOLR_HOST/PORT feed the preflight that creates versioned cores
# (alliancemine-search-{release}[-rc{N}], same for autocomplete).
# Defaults match the multitenant host inside AWS.
# SOLR_HOST=172.31.59.87
# SOLR_PORT=8983
#
# SSH key for the Solr preflight. Leave unset on AllianceMineDev — the
# host's ec2-user keys already authenticate to multitenant. Set when running
# the build container from outside AWS (your laptop).
# SOLR_SSH_KEY=/root/.ssh/AGR-ssl3.pem
#
# URL overrides — only set if you want to point at non-default cores
# (e.g. reusing production cores during a candidate test). When unset,
# entrypoint.sh derives the URLs from SOLR_HOST/PORT + release + RC.
# SOLR_INDEX_URL=http://solr-host:8983/solr/alliancemine-search
# SOLR_AUTOCOMPLETE_URL=http://solr-host:8983/solr/alliancemine-autocomplete

# Docker Build (optional)
# Override the branches the image clones at build time. The bio-sources repo
# also ships the Alliance API fetcher scripts (scripts/fetch_all.py) used by
# extract_data.py; set BIO_SOURCES_BRANCH to a feature branch (e.g.
# wire-api-sources) to test new fetchers before they merge to master.
# ALLIANCEMINE_BRANCH=master
# BIO_SOURCES_BRANCH=master
# IMAGE_TAG=latest

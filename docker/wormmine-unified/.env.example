# ============================================
# WormMine Docker Environment Configuration
# ============================================
# Copy this file to .env and configure with your values

# ============================================
# Container Configuration
# ============================================
IMAGE_TAG=latest
WORMMINE_BRANCH=master
BIO_SOURCES_BRANCH=master

# ============================================
# WormBase Release
# ============================================
WORMBASE_RELEASE=WS290

# Optional suffix for database name
# Example: _test, _dev, _prod
DB_VERSION_SUFFIX=

# ============================================
# RDS PostgreSQL Connection
# ============================================
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=your_password_here

# Database names (constructed automatically, but can override)
RDS_DB_NAME=wormmine_ws290
RDS_PROFILE_DB_NAME=wormmine_userprofile

# ============================================
# Port Configuration
# ============================================
TOMCAT_PORT=8080
SOLR_PORT=8983

# ============================================
# Notes
# ============================================
# - Database names are auto-generated from WORMBASE_RELEASE
# - WS290 becomes wormmine_ws290
# - Databases are created automatically on startup
# - Manual operations mode by default (no auto-start of Solr/Tomcat)

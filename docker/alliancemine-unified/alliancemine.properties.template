# ============================================
# AllianceMine Properties File
# Generated from template by docker-entrypoint.sh
# ============================================

# ============================================
# Production Database (Main Data)
# ============================================
db.production.datasource.serverName=${RDS_HOST}
db.production.datasource.databaseName=${RDS_DB_NAME}
db.production.datasource.user=${RDS_USER}
db.production.datasource.password=${RDS_PASSWORD}
db.production.datasource.ssl=true
db.production.datasource.sslfactory=org.postgresql.ssl.NonValidatingFactory
db.production.driver=org.postgresql.Driver
db.production.platform=PostgreSQL

# ============================================
# Common Target Items Database
# ============================================
db.common-tgt-items.datasource.serverName=${RDS_HOST}
db.common-tgt-items.datasource.databaseName=${RDS_DB_NAME}
db.common-tgt-items.datasource.user=${RDS_USER}
db.common-tgt-items.datasource.password=${RDS_PASSWORD}
db.common-tgt-items.datasource.ssl=true
db.common-tgt-items.datasource.sslfactory=org.postgresql.ssl.NonValidatingFactory
db.common-tgt-items.driver=org.postgresql.Driver
db.common-tgt-items.platform=PostgreSQL

# ============================================
# User Profile Database
# ============================================
db.userprofile-production.datasource.serverName=${RDS_HOST}
db.userprofile-production.datasource.databaseName=${RDS_PROFILE_DB_NAME}
db.userprofile-production.datasource.user=${RDS_USER}
db.userprofile-production.datasource.password=${RDS_PASSWORD}
db.userprofile-production.datasource.ssl=true
db.userprofile-production.datasource.sslfactory=org.postgresql.ssl.NonValidatingFactory
db.userprofile-production.driver=org.postgresql.Driver
db.userprofile-production.platform=PostgreSQL

# ============================================
# Project Configuration
# ============================================
project.title=AllianceMine
project.subTitle=Alliance of Genome Resources
project.releaseVersion=${ALLIANCE_RELEASE}
project.sitePrefix=http://localhost:8080
project.helpLocation=https://www.alliancegenome.org

# ============================================
# Web Application Configuration
# ============================================
webapp.deploy.url=http://localhost:8080/manager/text
webapp.baseurl=http://localhost:8080
webapp.path=alliancemine
webapp.manager=manager
webapp.password=manager

# Tomcat Manager credentials (for deployment)
tomcat.user=manager
tomcat.pwd=manager

# ============================================
# Solr Configuration
# ============================================
solr.url=http://localhost:${SOLR_PORT}/solr

# ============================================
# SuperUser Account
# ============================================
superuser.account=admin@alliancemine.org
superuser.password=admin

# ============================================
# OAuth (optional - configure if using OAuth)
# ============================================
# oauth2.providers=GOOGLE,GITHUB
# oauth2.GOOGLE.client.id=YOUR_GOOGLE_CLIENT_ID
# oauth2.GOOGLE.client.secret=YOUR_GOOGLE_CLIENT_SECRET

# ============================================
# External Links
# ============================================
links.mod=https://www.alliancegenome.org

# ============================================
# Performance Tuning
# ============================================
# Batch processing settings
batch.size=1000
webapp.os.alias=os.production

# Query result caching
webapp.query.cache.size=10000
webapp.query.cache.timeout=300

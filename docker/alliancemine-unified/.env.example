# ============================================
# AllianceMine Unified Container Configuration
# ============================================
# NOTE: This container uses the project root .env file
#       (../../.env) - NO local .env file needed!
# ============================================
# This file documents the required variables that should
# exist in the root .env file for AllianceMine to work.
# ============================================

# ============================================
# Required in Project Root .env
# ============================================

# AWS RDS Connection (already in root .env)
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=your_rds_password_here
RDS_DB_NAME=alliancemine_db
RDS_PROFILE_DB_NAME=alliancemine_profiles_db

# AllianceMine release version (already in root .env)
ALLIANCE_RELEASE=8.2.0

# Auto-build on first start (add to root .env if desired)
AUTO_BUILD=false

# ============================================
# Optional Build Settings
# ============================================

# Git branches to use (defaults to master if not set)
# ALLIANCEMINE_BRANCH=master
# BIO_SOURCES_BRANCH=master

# Docker image tag (defaults to latest if not set)
# IMAGE_TAG=latest

# ============================================
# Optional Service Ports
# ============================================

# Change these in root .env if you have port conflicts
# TOMCAT_PORT=8080
# SOLR_PORT=8983

# ============================================
# Optional Resource Overrides
# ============================================

# Override Java memory settings (defaults set in docker-compose.yml)
# CATALINA_OPTS=-Xmx16g -Xms8g -XX:+UseG1GC
# SOLR_JAVA_MEM=-Xmx4g -Xms2g

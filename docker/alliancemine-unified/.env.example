# ============================================
# AllianceMine Unified Container Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# AWS RDS Connection
# ============================================
# Get these from: uv run python -m src.cli.rds_manager status
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=your_rds_password_here

# Database names (created automatically if don't exist)
RDS_DB_NAME=alliancemine_db
RDS_PROFILE_DB_NAME=alliancemine_profiles_db

# ============================================
# Application Settings
# ============================================
# AllianceMine release version (appears in web interface)
ALLIANCE_RELEASE=8.2.0

# Automatically build InterMine on first container start
# Set to 'true' to auto-build, 'false' to build manually
# Default: false (manual build with 'docker-compose run alliancemine build')
AUTO_BUILD=false

# ============================================
# Build Settings
# ============================================
# Git branches to use
ALLIANCEMINE_BRANCH=master
BIO_SOURCES_BRANCH=master

# Docker image tag
IMAGE_TAG=latest

# ============================================
# Service Ports
# ============================================
# Change these if you have port conflicts
TOMCAT_PORT=8080
SOLR_PORT=8983

# ============================================
# Resource Limits (Optional)
# ============================================
# Uncomment and adjust if needed

# Java memory settings
# CATALINA_OPTS=-Xmx16g -Xms8g -XX:+UseG1GC
# SOLR_JAVA_MEM=-Xmx4g -Xms2g

# Container resource limits (in docker-compose.yml)
# MAX_CPUS=8
# MAX_MEMORY=32G

# RDS Connection Settings (REQUIRED)
DB_HOST=build-alliancemine-20240103.xxxx.us-east-1.rds.amazonaws.com
DB_PASSWORD=your-rds-password

# RDS Database Names (optional - defaults shown)
DB_NAME=alliancemine_db
DB_PROFILE_NAME=alliancemine_profiles_db
DB_USER=postgres
DB_PORT=5432

# Alliance Release Version
ALLIANCE_RELEASE=8.2.0

# GitHub Branches (optional - for development)
ALLIANCEMINE_BRANCH_NAME=master
BIO_SOURCES_BRANCH_NAME=master

# Environment
ENVIRONMENT=stage
SOLR_HOST=stage-intermine-solr.alliancegenome.org

# AWS Region (for S3 backups if needed)
AWS_REGION=us-east-1
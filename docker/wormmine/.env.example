# WormMine Build Configuration
# Copy to .env and fill in values

# RDS Connection (required)
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=

# WormBase Release Version (required)
# Free-form string used to suffix the production DB name. WormBase publishes
# WS-prefixed releases (WS298, WS299, ...). Defaults to today's date if unset.
# WORMBASE_RELEASE=WS298

# Build Type: test or production (default: test)
BUILD_TYPE=test

# RC Number (optional)
# If not set, auto-detected from RDS (finds highest existing RC and increments)
# RC_NUMBER=1

# Profile Database (optional)
# Test builds default to wormmine_userprofile_test (safe, not production).
# Production builds always use wormmine_userprofile.
# Set COPY_PROFILE_DB=true to create a fresh per-RC copy.
# COPY_PROFILE_DB=true

# Deployment Target (optional - external Tomcat on multitenant)
# DEPLOY_HOST=ec2-host.example.com
# DEPLOY_PORT=8080
# DEPLOY_MANAGER=manager
# DEPLOY_PASSWORD=manager
# WEBAPP_BASEURL=http://localhost:8080
# SUPERUSER_ACCOUNT=superuser@mail_account
# SUPERUSER_PASSWORD=

# Docker Build (optional)
# Override the branches the image clones at build time. Defaults im-298 / im-293
# correspond to WormBase release WS298.
# WORMMINE_BRANCH=im-298
# WORMMINE_BIO_SOURCES_BRANCH=im-293
# IMAGE_TAG=latest

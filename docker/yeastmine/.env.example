# YeastMine Build Configuration
# Copy to .env and fill in values

# RDS Connection (required)
RDS_HOST=intermine-postgres.cmnnhlso7wdi.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=

# YeastMine Release Version (recommended)
# Free-form string used to suffix the production DB name. SGD ships
# R64-x-y releases (current as of 2026: R64-5-1); use whichever the
# build aligns with. Defaults to today's date if unset.
# YEASTMINE_RELEASE=R64-5-1

# Build Type: test or production (default: test)
BUILD_TYPE=test

# RC Number (optional)
# If not set, auto-detected from RDS (finds highest existing RC and increments)
# RC_NUMBER=1

# Profile Database (optional)
# Test builds default to yeastmine_userprofile_test (safe, not production).
# Production builds always use yeastmine_userprofile.
# Set COPY_PROFILE_DB=true to create a fresh per-RC copy.
# COPY_PROFILE_DB=true

# Deployment Target (optional - external Tomcat on multitenant)
# DEPLOY_HOST=ec2-host.example.com
# DEPLOY_PORT=8080
# DEPLOY_MANAGER=manager
# DEPLOY_PASSWORD=

# Webapp base URL — used in BLAST links, REST responses, etc.
# WEBAPP_BASEURL=http://localhost:8080

# SuperUser Account (REQUIRED for the deployed webapp to start)
# Leaving as the upstream "superuser@mail_account" placeholder makes
# the InitialiserPlugin throw "Userprofile does not have a super user"
# at first hit. Set this to the username present in yeastmine_userprofile.
# See docs/PRODUCTION_CUTOVER_RC20.md for the MouseMine variant of this trap.
# SUPERUSER_ACCOUNT=superuser
# SUPERUSER_PASSWORD=secret

# Image Tag (optional)
# IMAGE_TAG=latest

# Pin to a specific upstream branch (optional)
# YEASTMINE_BRANCH=master
# YEASTMINE_BIO_SOURCES_BRANCH=master

<?xml version="1.0" encoding="UTF-8"?>
<!--
  AGR-patched global Tomcat context.xml for InterMine 1.x.

  Patches vs stock Tomcat 8.5:
    - sessionCookiePath="/"           : cookie scope = whole host, prevents
                                        session loss when path changes
                                        (e.g. /mousemine -> /mousemine/portal.do)
    - useHttpOnly="false"             : allow JS access to JSESSIONID; required
                                        by InterMine's IM-tables AJAX
    - clearReferencesStopTimerThreads : clear ScheduledExecutor refs on undeploy
                                        to prevent thread + memory leak after
                                        repeated WAR redeploys (Hikari + InterMine
                                        prefetch manager)

  See docs/INTERMINE_TOMCAT_DOCKER.md (§8.2 patch 2) for full reasoning.
-->
<Context sessionCookiePath="/"
         useHttpOnly="false"
         clearReferencesStopTimerThreads="true">

    <!-- Default set of monitored resources. If one of these changes, the    -->
    <!-- web application will be reloaded.                                   -->
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>WEB-INF/tomcat-web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <!-- Uncomment this to disable session persistence across Tomcat restarts -->
    <!--
    <Manager pathname="" />
    -->
</Context>
